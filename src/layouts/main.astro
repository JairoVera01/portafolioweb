---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/jetbrains-mono";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
} = Astro.props;
import { SEO } from "astro-seo";

// i18n: idioma y rutas alternas según el path
const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const lang = isEnglish ? "en" : "es";
const ogLocale = isEnglish ? "en_US" : "es_ES";
const jsonLdLang = isEnglish ? "en-US" : "es-ES";
const socialAlt = isEnglish
  ? "Jairo Vera - Front-End Developer"
  : "Jairo Vera - Desarrollador Front-End";
// Ruta base en español (sin el prefijo /en) para construir las alternas
const basePath = isEnglish ? pathname.replace(/^\/en/, "") || "/" : pathname;
const esHref = new URL(basePath, Astro.site).toString();
const enHref = new URL(
  "/en" + (basePath === "/" ? "/" : basePath),
  Astro.site
).toString();

// Datos estructurados por defecto
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jairo Vera",
  jobTitle: "Desarrollador Front-End",
  description:
    "Desarrollador front-end con más de 4 años de experiencia creando interfaces web y móviles rápidas, limpias y bien construidas.",
  url: "https://jairovera.dev",
  image: "https://jairovera.dev/assets/images/openG.png",
  sameAs: [
    "https://www.linkedin.com/in/frank-jairo-vera/",
    "https://github.com/JairoVera01",
  ],
  knowsAbout: [
    "JavaScript",
    "TypeScript",
    "React",
    "Next.js",
    "Astro",
    "React Native",
    "Tailwind CSS",
    "Sass",
    "Desarrollo Web",
    "Frontend Development",
    "Mobile Development",
  ],
  offers: {
    "@type": "Service",
    name: "Desarrollo Front-End Web y Móvil",
    description:
      "Servicios de desarrollo front-end para web y aplicaciones móviles para empresas y emprendedores.",
  },
};

// Esquema WebSite (idioma dinámico, sin SearchAction inexistente)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Jairo Vera - Desarrollador Front-End",
  alternateName: "JairoVera.dev",
  url: "https://jairovera.dev",
  description:
    "Portafolio profesional de Jairo Vera, desarrollador front-end especializado en interfaces web y móviles.",
  inLanguage: jsonLdLang,
  isAccessibleForFree: true,
  creator: { "@type": "Person", name: "Jairo Vera" },
};

// Meta datos mejorados
const defaultTitle =
  "Jairo Vera - Desarrollador Front-End | Web & Mobile";
const defaultDescription =
  "Desarrollador web front end especializado en crear sitios web modernos, rápidos y optimizados. Experto en React, NextJs, Astro y tecnologías web modernas. ¡Convierte tu idea en realidad digital!";
const defaultImage = "https://jairovera.dev/assets/images/openG.png";

const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const pageImage = defaultImage;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Marca JS disponible antes de pintar: las animaciones de reveal solo se
         ocultan cuando hay JS, así el contenido nunca queda invisible sin él. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Preconnect para mejorar rendimiento -->
    <link rel="preconnect" href="https://www.clarity.ms" />

    <!-- Tipografías autoalojadas vía Fontsource (Space Grotesk, Hanken Grotesk,
         JetBrains Mono) — importadas en el frontmatter, sin CDN externo. -->

    <title>{pageTitle}</title>

    <!-- Favicons optimizados -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <!-- Meta tags de SEO básico -->
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="desarrollador web, programador front end, sitios web modernos, React developer, Astro developer, JavaScript expert, frontend developer, backend developer, desarrollo web profesional, páginas web optimizadas, SEO web, responsive design, Jairo Vera desarrollador"
    />
    <meta name="author" content="Jairo Vera" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />

    <!-- Geo tags -->
    <meta name="geo.region" content="PE" />
    <meta name="geo.placename" content="Lima, Perú" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternativas de idioma (hreflang) -->
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Datos estructurados JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Open Graph mejorado -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={defaultImage} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Jairo Vera - Desarrollador Web" />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={isEnglish ? "es_ES" : "en_US"}
    />

    <!-- Twitter Cards mejorado -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={defaultImage} />
    <meta name="twitter:image:alt" content={socialAlt} />

    <!-- LinkedIn específico -->
    <meta property="article:author" content="Jairo Vera" />

    <!-- Para WhatsApp -->
    <meta property="og:image:type" content="image/png" />

    <!-- Tema color para navegadores móviles -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />

    <!-- Security headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />

    <!-- CSP: fuentes autoalojadas, formulario hacia WhatsApp (sin worker/Turnstile) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://www.clarity.ms;"
    />

    <!-- Design tokens y base del rediseño (global) -->
    <style is:global>
      :root {
        --accent: #2455ff;
        --accent-soft: #eef1ff;
        --ink: #18181b;
        --ink-strong: #0a0a0b;
        --muted: #52525b;
        --muted-2: #71717a;
        --muted-3: #a1a1aa;
        /* Variante accesible (>= AA en blanco) para texto pequeño informativo */
        --muted-3-text: #6c6c75;
        --line: #e4e4e7;
        --line-soft: #ececee;
        --font-display: "Space Grotesk Variable", "Space Grotesk", sans-serif;
        --font-body: "Hanken Grotesk Variable", "Hanken Grotesk", sans-serif;
        --font-mono: "JetBrains Mono Variable", "JetBrains Mono", monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        color: var(--ink);
        background: #ffffff;
        -webkit-font-smoothing: antialiased;
        /* Espejo del root overflow:hidden del diseño: evita scroll horizontal
           por las decoraciones del hero que sobresalen del recorte. */
        overflow-x: clip;
      }

      ::selection {
        background: var(--accent);
        color: #fff;
      }

      img {
        height: auto;
        max-width: 100%;
      }

      .prose img {
        border-radius: 20px;
      }

      /* Contenedor central del rediseño */
      .jv-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 28px;
      }

      /* Stacking: chrome y contenido por encima del fondo fijo */
      .site-header {
        position: relative;
        z-index: 50;
      }
      main {
        position: relative;
        z-index: 1;
      }
      .site-footer {
        position: relative;
        z-index: 1;
      }

      /* Animaciones del rediseño */
      @keyframes jv-marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      @keyframes jv-blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      @keyframes jv-float {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-7px);
        }
      }
      @keyframes jv-spin-slow {
        to {
          transform: rotate(360deg);
        }
      }
      /* Secciones "En vivo" y "Proyectos" (rediseño) */
      @keyframes jv-pulse {
        0% {
          box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.45);
        }
        70% {
          box-shadow: 0 0 0 7px rgba(22, 163, 74, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
        }
      }
      @keyframes jv-nodepulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 1;
        }
        50% {
          transform: scale(1.28);
          opacity: 0.7;
        }
      }
      @keyframes jv-shine {
        0% {
          transform: translateX(-160%) skewX(-18deg);
        }
        55%,
        100% {
          transform: translateX(320%) skewX(-18deg);
        }
      }
      @keyframes jv-bob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      /* Reveal on scroll — solo se oculta cuando hay JS (html.js). Sin JS el
         contenido permanece visible (ver script is:inline y noscript en head). */
      html.js [data-reveal] {
        opacity: 0;
        transform: translateY(22px);
        transition:
          opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
          transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: opacity, transform;
      }
      html.js [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }

      @media (max-width: 640px) {
        .jv-container {
          padding: 0 20px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      }
    </style>

    <!-- Scripts críticos -->
    <script src="../assets/css/main.css"></script>
    <Fragment set:html={import.meta.env.HEADER_INJECT} />

    <!-- Lenis para smooth scrolling -->
    <script is:inline src="/scripts/vendor/lenis/lenis.js"></script>
    <script is:inline>
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: "vertical",
        gestureDirection: "vertical",
        smooth: true,
        mouseMultiplier: 1,
        smoothTouch: false,
        touchMultiplier: 2,
        infinite: false,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "oe3ka5jfbh");
    </script>
  </head>

  <body class="antialiased bg-white">
    <!-- Skip to main content para accesibilidad -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded"
    >
      Saltar al contenido principal
    </a>

    <SquareLines />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script src="../assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />

    <style>
      /* CSS optimizado para scrollbar y Lenis */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      html.lenis,
      html.lenis body {
        height: auto;
      }

      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }

      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }

      .lenis.lenis-stopped {
        overflow: hidden;
      }

      .lenis.lenis-scrolling iframe {
        pointer-events: none;
      }

      /* Mejorar accesibilidad */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .focus\:not-sr-only:focus {
        position: static;
        width: auto;
        height: auto;
        padding: 0;
        margin: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
      }
    </style>

    <!-- Título dinámico al cambiar de pestaña (según idioma de la página) -->
    <script>
      const originalTitle = document.title;
      const awayTitle =
        document.documentElement.lang === "en"
          ? "Come back soon · Jairo Vera"
          : "¡Vuelve pronto! · Jairo Vera";

      document.addEventListener("visibilitychange", function () {
        document.title = document.hidden ? awayTitle : originalTitle;
      });

      window.addEventListener("focus", function () {
        document.title = originalTitle;
      });
    </script>

    <!-- Schema markup WebSite (idioma dinámico) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
  </body>
</html>
