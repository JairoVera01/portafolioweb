---
// Layout «Taller»: <head> SEO del sitio + script de tema + canvas WebGL + masthead.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import GLCanvas from "../components/GLCanvas.astro";
import Masthead from "../components/Masthead.astro";
import { DICT, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  type?: string;
  noindex?: boolean;
  /** Las páginas sin piezas 3D (404) pueden prescindir del canvas */
  gl?: boolean;
}
const { lang, title, description, type = "website", noindex = false, gl = true } = Astro.props;
const t = DICT[lang];
const isEnglish = lang === "en";

// i18n: rutas alternas (es sin prefijo, en bajo /en)
const pathname = Astro.url.pathname;
const basePath = isEnglish ? pathname.replace(/^\/en/, "") || "/" : pathname;
const esPath = basePath;
const enPath = "/en" + (basePath === "/" ? "/" : basePath);
const esHref = new URL(esPath, Astro.site).toString();
const enHref = new URL(enPath, Astro.site).toString();
const ogLocale = isEnglish ? "en_US" : "es_ES";
const jsonLdLang = isEnglish ? "en-US" : "es-ES";
const socialAlt = isEnglish ? "Jairo Vera - Front-End Developer" : "Jairo Vera - Desarrollador Front-End";

// Datos estructurados
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jairo Vera",
  jobTitle: isEnglish ? "Front-End Developer" : "Desarrollador Front-End",
  description: isEnglish
    ? "Front-end developer with 4+ years of experience building fast, clean, well-crafted web and mobile interfaces."
    : "Desarrollador front-end con más de 4 años de experiencia creando interfaces web y móviles rápidas, limpias y bien construidas.",
  url: "https://jairovera.dev",
  image: "https://jairovera.dev/assets/images/openG.png",
  sameAs: ["https://www.linkedin.com/in/frank-jairo-vera/", "https://github.com/JairoVera01"],
  knowsAbout: ["JavaScript", "TypeScript", "React", "Next.js", "Astro", "React Native", "Tailwind CSS", "Sass", "Desarrollo Web", "Frontend Development", "Mobile Development"],
  offers: {
    "@type": "Service",
    name: isEnglish ? "Front-End Web & Mobile Development" : "Desarrollo Front-End Web y Móvil",
    description: isEnglish
      ? "Front-end development services for websites and mobile apps, for businesses and entrepreneurs."
      : "Servicios de desarrollo front-end para web y aplicaciones móviles para empresas y emprendedores.",
  },
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Jairo Vera - Desarrollador Front-End",
  alternateName: "JairoVera.dev",
  url: "https://jairovera.dev",
  description: "Portafolio profesional de Jairo Vera, desarrollador front-end especializado en interfaces web y móviles.",
  inLanguage: jsonLdLang,
  isAccessibleForFree: true,
  creator: { "@type": "Person", name: "Jairo Vera" },
};

const defaultTitle = isEnglish ? "Jairo Vera - Front-End Developer | Web & Mobile" : "Jairo Vera - Desarrollador Front-End | Web & Mobile";
const defaultDescription = isEnglish
  ? "Front-end developer with 4+ years of experience building fast, well-crafted web and mobile apps with Astro, Next.js, React and React Native. Browse my projects and let's talk."
  : "Desarrollador web front end especializado en crear sitios web modernos, rápidos y optimizados. Experto en React, NextJs, Astro y tecnologías web modernas. ¡Convierte tu idea en realidad digital!";
const defaultImage = "https://jairovera.dev/assets/images/openG.png";
const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const canonicalURL = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tema antes de pintar (sin destello): preferencia guardada o la del sistema -->
    <script is:inline>
      (() => {
        let t;
        try {
          t = localStorage.getItem("jv-theme");
        } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <link rel="preconnect" href="https://www.clarity.ms" />

    <title>{pageTitle}</title>

    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="desarrollador web, programador front end, sitios web modernos, React developer, Astro developer, JavaScript expert, frontend developer, backend developer, desarrollo web profesional, páginas web optimizadas, SEO web, responsive design, Jairo Vera desarrollador"
    />
    <meta name="author" content="Jairo Vera" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="bingbot" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <meta name="geo.region" content="PE" />
    <meta name="geo.placename" content="Lima, Perú" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={defaultImage} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Jairo Vera - Desarrollador Web" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={isEnglish ? "es_ES" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={defaultImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <meta property="article:author" content="Jairo Vera" />

    <!-- Color de la barra del navegador: papel claro / papel oscuro -->
    <meta name="theme-color" content="#f1eee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content="#f1eee6" />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />

    <!-- CSP: fuentes y three/cannon autoalojados (empaquetados por Vite).
         Clarity carga su script desde scripts.clarity.ms y envía a *.clarity.ms. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.clarity.ms;"
    />

    <Fragment set:html={import.meta.env.HEADER_INJECT} />

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "oe3ka5jfbh");
    </script>
  </head>

  <body class="min-h-dvh">
    <a
      href="#main-content"
      class="sr-only z-50 rounded-full bg-ink px-4 py-2 text-[14px] font-semibold text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-3"
    >
      {t.skip}
    </a>

    {gl && <GLCanvas />}
    <Masthead lang={lang} esPath={esPath} enPath={enPath} />

    <main id="main-content" class="relative z-[1]">
      <slot />
    </main>

    <Fragment set:html={import.meta.env.FOOTER_INJECT} />

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll.js";
      import { initLimaClock } from "../scripts/lima-clock.js";

      initSmoothScroll();
      initLimaClock();

      // Título al cambiar de pestaña
      const originalTitle = document.title;
      const awayTitle = document.documentElement.lang === "en" ? "Come back soon · Jairo Vera" : "¡Vuelve pronto! · Jairo Vera";
      document.addEventListener("visibilitychange", () => {
        document.title = document.hidden ? awayTitle : originalTitle;
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </body>
</html>
