---
// Layout «Taller»: <head> SEO del sitio + script de tema + canvas WebGL + masthead.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/jetbrains-mono";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import GLCanvas from "../components/GLCanvas.astro";
import Masthead from "../components/Masthead.astro";
import { DICT, type Lang } from "../i18n/content";
import { META, personNode, websiteNode } from "../i18n/seo";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  type?: string;
  noindex?: boolean;
  /** Las páginas sin piezas 3D (404) pueden prescindir del canvas */
  gl?: boolean;
  /** Nodos schema.org propios de la página; se suman a la persona y el sitio en un @graph */
  schema?: Record<string, unknown>[];
}
const { lang, title, description, type = "website", noindex = false, gl = true, schema = [] } = Astro.props;
const t = DICT[lang];
const isEnglish = lang === "en";

// i18n: rutas alternas (es sin prefijo, en bajo /en)
const pathname = Astro.url.pathname;
const basePath = isEnglish ? pathname.replace(/^\/en/, "") || "/" : pathname;
const esPath = basePath;
const enPath = "/en" + (basePath === "/" ? "/" : basePath);
const esHref = new URL(esPath, Astro.site).toString();
const enHref = new URL(enPath, Astro.site).toString();

// Textos sociales por idioma. es_PE porque el sitio se escribe desde Lima.
const ogLocale = isEnglish ? "en_US" : "es_PE";
const ogLocaleAlt = isEnglish ? "es_PE" : "en_US";
const siteName = isEnglish ? "Jairo Vera — Front-end developer" : "Jairo Vera — Desarrollador front-end";
const { title: defaultTitle, description: defaultDescription } = META.home[lang];
const ogImage = new URL(`/og/jairovera-${lang}.png`, Astro.site).toString();
const ogImageAlt = isEnglish
  ? "Jairo Vera. Front-end developer in Lima, Peru: websites and apps that feel handmade."
  : "Jairo Vera. Desarrollador front-end en Lima, Perú: webs y apps que se sienten hechas a mano.";
const keywords = isEnglish
  ? "front-end developer, web developer Lima Peru, Astro developer, Next.js developer, React Native developer, websites for businesses, web performance, technical SEO, Jairo Vera"
  : "desarrollador front-end, desarrollador web Lima Perú, desarrollador Astro, desarrollador Next.js, React Native, páginas web para negocios, rendimiento web, SEO técnico, Jairo Vera";
const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const canonicalURL = new URL(pathname, Astro.site);
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Un único bloque JSON-LD: persona + sitio + lo propio de la página
const jsonLd = { "@context": "https://schema.org", "@graph": [personNode(lang), websiteNode(lang), ...schema] };
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tema antes de pintar (sin destello): preferencia guardada o la del sistema -->
    <script is:inline>
      (() => {
        let t;
        try {
          t = localStorage.getItem("jv-theme");
        } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <link rel="preconnect" href="https://www.clarity.ms" />

    <title>{pageTitle}</title>

    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Jairo Vera" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />

    <meta name="geo.region" content="PE-LIM" />
    <meta name="geo.placename" content="Lima, Perú" />

    {
      /* Canonical y alternas solo en páginas indexables (la 404 no las declara) */
      !noindex && (
        <>
          <link rel="canonical" href={canonicalURL} />
          <link rel="alternate" hreflang="es" href={esHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={esHref} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Color de la barra del navegador: papel claro / papel oscuro -->
    <meta name="theme-color" content="#f1eee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content="#f1eee6" />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-XSS-Protection" content="1; mode=block" />

    <!-- CSP: fuentes y three/cannon autoalojados (empaquetados por Vite).
         Clarity carga su script desde scripts.clarity.ms y envía a *.clarity.ms. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.clarity.ms;"
    />

    <Fragment set:html={import.meta.env.HEADER_INJECT} />

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "oe3ka5jfbh");
    </script>
  </head>

  <body class="min-h-dvh">
    <a
      href="#main-content"
      class="sr-only z-50 rounded-full bg-ink px-4 py-2 text-[14px] font-semibold text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-3"
    >
      {t.skip}
    </a>

    {gl && <GLCanvas />}
    <Masthead lang={lang} esPath={esPath} enPath={enPath} />

    <main id="main-content" class="relative z-[1]">
      <slot />
    </main>

    <Fragment set:html={import.meta.env.FOOTER_INJECT} />

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll.js";
      import { initLimaClock } from "../scripts/lima-clock.js";

      initSmoothScroll();
      initLimaClock();

      // Título al cambiar de pestaña
      const originalTitle = document.title;
      const awayTitle = document.documentElement.lang === "en" ? "Come back soon · Jairo Vera" : "¡Vuelve pronto! · Jairo Vera";
      document.addEventListener("visibilitychange", () => {
        document.title = document.hidden ? awayTitle : originalTitle;
      });
    </script>
  </body>
</html>
