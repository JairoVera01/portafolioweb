---
import { Image } from "astro:assets";

const { lang = "es" } = Astro.props;
const isEn = lang === "en";

const t = isEn
  ? {
      badge: "Front-End Developer · Web & Mobile",
      h1Pre: "I build web and mobile interfaces that feel ",
      h1Hl: "alive",
      h1Post: ".",
      intro:
        'I\'m <strong>Jairo Vera</strong>, a front-end developer with <strong>4+ years</strong> of experience building fast, clean, well-crafted products — for companies across Peru, Mexico, Chile and Puerto Rico.',
      linkedin: "Follow me on LinkedIn",
    }
  : {
      badge: "Front-End Developer · Web & Mobile",
      h1Pre: "Construyo interfaces web y móviles que se sienten ",
      h1Hl: "vivas",
      h1Post: ".",
      intro:
        'Soy <strong>Jairo Vera</strong>, desarrollador front-end con <strong>4+ años</strong> de experiencia creando productos rápidos, limpios y bien construidos — para empresas en Perú, México, Chile y Puerto Rico.',
      linkedin: "Sígueme en LinkedIn",
    };
---

<section id="top" class="hero">
  <div class="hero__copy">
    <div class="hero__badge" data-reveal>
      <span class="hero__badge-icon">&lt;/&gt;</span>
      {t.badge}
    </div>

    <h1 class="hero__title" data-reveal>
      {t.h1Pre}<span class="hero__hl">{t.h1Hl}</span>{t.h1Post}
    </h1>

    <p class="hero__intro" data-reveal set:html={t.intro} />

    <div class="hero__cta" data-reveal>
      <a
        href="https://www.linkedin.com/in/frank-jairo-vera/"
        target="_blank"
        rel="noopener"
        class="btn btn--dark"
      >
        {t.linkedin} <span class="btn__arrow">↗</span>
      </a>
      <a
        href="https://github.com/JairoVera01"
        target="_blank"
        rel="noopener"
        class="btn btn--light"
      >
        GitHub <span class="btn__arrow">↗</span>
      </a>
    </div>
  </div>

  <div class="hero__photo" data-reveal>
    <div class="hero__frame"></div>
    <div class="hero__shot">
      <Image
        src="/assets/images/port2.webp"
        alt="Jairo Vera"
        width={600}
        height={760}
        format="webp"
        quality={92}
        loading="eager"
        class="hero__img"
      />
      <div class="hero__shade"></div>
      <div class="hero__caption">
        <span>JAIRO_VERA.webp</span><span>// CAJAMARCA, PE</span>
      </div>
      <span class="hero__corner hero__corner--tl"></span>
      <span class="hero__corner hero__corner--tr"></span>
    </div>
    <div class="hero__wave">👋</div>
    <div class="hero__chip">
      <span class="hero__chip-dot"></span> React · Next · Astro · RN
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
    padding: 64px 0 36px;
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 26px;
  }
  .hero__badge-icon {
    color: var(--accent);
  }

  /* Título */
  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
    color: var(--ink-strong);
  }
  .hero__hl {
    color: var(--accent);
    position: relative;
    white-space: nowrap;
  }
  .hero__hl::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 100%;
    height: 9px;
    background: var(--accent);
    opacity: 0.16;
    z-index: -1;
    border-radius: 2px;
  }

  .hero__intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 460px;
    margin: 0 0 30px;
  }
  .hero__intro :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  /* Botones */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 22px;
    border-radius: 11px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .btn__arrow {
    font-family: var(--font-mono);
  }
  .btn--dark {
    background: var(--ink-strong);
    color: #fff;
  }
  .btn--dark:hover {
    transform: translateY(-2px);
    background: var(--accent);
  }
  .btn--light {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .btn--light:hover {
    transform: translateY(-2px);
    border-color: #18181b;
  }

  /* Foto */
  .hero__photo {
    position: relative;
    justify-self: center;
  }
  .hero__frame {
    position: absolute;
    inset: -14px;
    border: 1px dashed #d4d4d8;
    border-radius: 26px;
    z-index: 0;
  }
  .hero__shot {
    position: relative;
    z-index: 1;
    width: 300px;
    height: 380px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px -28px rgba(20, 30, 80, 0.45);
    border: 1px solid #e7e7e9;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 55%,
      rgba(8, 12, 40, 0.55) 100%
    );
  }
  .hero__caption {
    position: absolute;
    left: 14px;
    bottom: 13px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: 0.03em;
  }
  .hero__corner {
    position: absolute;
    top: 11px;
    width: 16px;
    height: 16px;
    border-top: 2px solid rgba(255, 255, 255, 0.85);
  }
  .hero__corner--tl {
    left: 11px;
    border-left: 2px solid rgba(255, 255, 255, 0.85);
  }
  .hero__corner--tr {
    right: 11px;
    border-right: 2px solid rgba(255, 255, 255, 0.85);
  }
  .hero__wave {
    position: absolute;
    z-index: 2;
    top: -18px;
    right: -18px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e7e7e9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.25);
    animation: jv-float 4s ease-in-out infinite;
  }
  .hero__chip {
    position: absolute;
    z-index: 2;
    bottom: -16px;
    left: -22px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #e7e7e9;
    box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.3);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink);
  }
  .hero__chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 44px 0 24px;
      text-align: center;
    }
    .hero__badge,
    .hero__cta {
      justify-content: center;
    }
    .hero__intro {
      margin-left: auto;
      margin-right: auto;
    }
    .hero__photo {
      margin: 6px auto 0;
    }
  }

  @media (max-width: 360px) {
    .hero__shot {
      width: 260px;
      height: 330px;
    }
  }
</style>
