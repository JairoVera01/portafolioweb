---
import SectionHead from "../SectionHead.astro";
import { DICT, STEPS, type Lang } from "../../i18n/content";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];
---

<section id="proceso" data-mode="shelf" class="container-taller pt-[180px]">
  <div class="reading">
    <SectionHead n="03" label={t.s3} />
    <h2 class="t-h2 mt-10">{t.prTitleA} <em class="t-em">{t.prTitleEm}</em></h2>
    <p class="mt-7 max-w-[560px] font-serif text-[21px] leading-[1.45]">{t.prLead}</p>
    <!-- Contenedor con margen negativo: los bordes izquierdos de cada paso quedan
         siempre dentro del grid y el último borde nunca queda huérfano al envolver -->
    <ol class="mt-16 grid list-none grid-cols-[repeat(auto-fit,minmax(150px,1fr))] border-t border-line p-0">
      {
        STEPS.map((s, i) => {
          const [title, text] = s[lang === "en" ? 1 : 0];
          return (
            <li class="group border-l border-line py-[22px] pr-[18px] pb-[30px] pl-4">
              <div
                aria-hidden="true"
                class="wdth-62 text-outline text-[96px] leading-[.85] font-extrabold tracking-[-0.05em] transition-[color,-webkit-text-stroke-color] duration-[350ms] group-hover:!text-accent group-hover:[-webkit-text-stroke-color:var(--ac)]"
              >
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="mt-[22px] mb-2 text-[21px] max-[420px]:text-[18px]font-bold tracking-[-0.015em]">
                <span class="sr-only">{i + 1}. </span>
                {title}
              </h3>
              <p class="m-0 font-serif text-[17.5px] leading-[1.42] text-muted">{text}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
