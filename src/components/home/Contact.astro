---
import SectionHead from "../SectionHead.astro";
import { CONTACT, DICT, type Lang } from "../../i18n/content";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];
const links = [
  { href: CONTACT.whatsapp, label: `WhatsApp · ${CONTACT.phone}` },
  { href: CONTACT.linkedin, label: "LinkedIn ↗" },
  { href: CONTACT.github, label: "GitHub ↗" },
];
---

<section id="contacto" data-mode="hola" class="container-taller flex min-h-[100svh] flex-col pt-[180px]">
  <SectionHead n="07" label={t.s6} />
  <h2 class="wdth-92 mt-7 mb-0 text-[clamp(76px,15vw,300px)] max-[480px]:text-[clamp(52px,19vw,76px)] leading-[.82] font-extrabold tracking-[-0.05em]">
    {t.cTitle}<span class="text-accent">.</span>
  </h2>
  <div class="mt-10 flex flex-wrap items-end justify-between gap-10">
    <div class="min-w-0 flex-[1_1_520px]">
      <p class="mb-7 max-w-[600px] font-serif text-[clamp(21px,1.9vw,26px)] leading-[1.4]">{t.cLead}</p>
      <a
        href={`mailto:${CONTACT.email}`}
        class="inline-block border-b-[3px] border-accent pb-1.5 text-[clamp(24px,3.4vw,54px)] leading-[1.1] font-semibold tracking-[-0.03em] break-all"
      >{CONTACT.email}</a>
      <div class="mt-[30px] flex flex-wrap gap-x-7 gap-y-3 text-[17px] font-semibold">
        {
          links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="border-b-[1.5px] border-line pb-[3px]">
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
    <p class="m-0 font-serif text-[21px] italic">{t.cTimeA} <time data-lima-time>--:--</time> {t.cTimeB}</p>
  </div>
  <div class="min-h-[200px] flex-1"></div>
  <footer class="flex flex-wrap justify-between gap-4 border-t border-line pt-[22px] pb-7 font-mono text-[12px]">
    <span>© 2026 Jairo Vera — {t.foot}</span>
    <a href="#inicio">{t.top} ↑</a>
  </footer>
</section>
