---
// Servicios «Taller» (README §6.3): selector de audiencia + cuatro filas.
// Los dos textos de cada fila van precargados y apilados en la misma celda de grid:
// la fila mide siempre lo del más largo y el cambio es solo un fundido de opacidad.
import SectionHead from "../SectionHead.astro";
import { DICT, SERVICES, type Lang } from "../../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];
const groupLabel = lang === "en" ? "Who is it for?" : "¿Para quién es?";
const audiences = [
  { id: "biz", label: t.audBiz },
  { id: "team", label: t.audTeam },
] as const;
const rows = SERVICES.map((service, i) => {
  const [title, biz, bizFor, team, teamWith] = service[lang];
  return {
    n: String(i + 1).padStart(2, "0"),
    title,
    variants: [
      { aud: "biz", text: biz, tag: t.forBiz + bizFor },
      { aud: "team", text: team, tag: t.forTeam + teamWith },
    ],
  };
});
---

<section id="servicios" data-mode="shelf" class="container-taller pt-[140px]">
  <div class="services reading" data-services data-aud="biz">
    <SectionHead n="01" label={t.s1} />
    <h2 class="t-h2 mt-10">{t.sTitleA} <em class="t-em">{t.sTitleEm}</em></h2>

    <!-- En móvil los dos botones se reparten el ancho y su texto puede partirse en dos líneas -->
    <div
      role="group"
      aria-label={groupLabel}
      class="mt-10 flex gap-1 rounded-full border border-ink p-1 text-[15px] font-semibold sm:inline-flex"
    >
      {
        audiences.map((a, i) => (
          <button
            type="button"
            data-aud-btn={a.id}
            aria-pressed={i === 0 ? "true" : "false"}
            class="rounded-full px-[18px] py-2.5 max-sm:leading-tight transition-[background-color,color] duration-[250ms] ease-out focus-visible:outline-offset-1 aria-pressed:bg-ink aria-pressed:text-paper max-sm:flex-1 max-sm:text-balance max-sm:px-3 hover:not-aria-pressed:text-accent"
          >
            {a.label}
          </button>
        ))
      }
    </div>

    <ol role="list" class="mt-12 border-t border-line">
      {
        rows.map((row) => (
          <li class="grid grid-cols-[40px_minmax(0,1fr)] items-baseline gap-x-6 gap-y-3 border-b border-line py-[30px] wide:grid-cols-[56px_minmax(0,1fr)_minmax(0,1.25fr)]">
            <span class="font-mono text-[12.5px]">{row.n}</span>
            <h3 class="svc-title cursor-default text-[clamp(30px,3.3vw,46px)] font-bold leading-none tracking-[-0.03em]">
              {row.title}
            </h3>
            <div class="col-start-2 grid wide:col-start-auto">
              {row.variants.map((v) => (
                <div class="svc-variant [grid-area:1/1]" data-v={v.aud}>
                  <p class="font-serif text-[20px] leading-[1.45]">{v.text}</p>
                  <p class="mt-3 font-mono text-[12px] text-muted">{v.tag}</p>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- En línea y justo después del marcado: la audiencia guardada se aplica antes de pintar -->
<script is:inline>
  (() => {
    const root = document.querySelector("[data-services]");
    if (!root) return;
    const buttons = root.querySelectorAll("[data-aud-btn]");
    const set = (aud) => {
      root.dataset.aud = aud;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.audBtn === aud)));
    };
    try {
      if (sessionStorage.getItem("jv-aud") === "team") set("team");
    } catch {}
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const aud = b.dataset.audBtn;
        if (root.dataset.aud === aud) return;
        set(aud);
        try {
          sessionStorage.setItem("jv-aud", aud);
        } catch {}
      }),
    );
  })();
</script>

<style>
  .svc-title {
    font-variation-settings: "wdth" 82;
    transition:
      font-variation-settings 0.6s var(--ease-taller),
      color 0.3s ease;
  }
  @media (hover: hover) {
    .svc-title:hover {
      font-variation-settings: "wdth" 125;
      color: var(--ac);
    }
  }

  /* Fundido de 200ms "con valle": el texto que sale cae rápido y el que entra arranca
     despacio, así nunca se leen los dos a la vez. visibility saca al oculto del árbol
     de accesibilidad y de la búsqueda en página cuando termina de desvanecerse. */
  .svc-variant {
    transition:
      opacity 0.2s cubic-bezier(0.4, 0, 1, 1),
      visibility 0s;
  }
  .services[data-aud="biz"] .svc-variant[data-v="team"],
  .services[data-aud="team"] .svc-variant[data-v="biz"] {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s var(--ease-taller),
      visibility 0s linear 0.2s;
  }
</style>
