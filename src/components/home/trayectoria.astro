---
const { lang = "es" } = Astro.props;
const isEn = lang === "en";

const t = isEn
  ? {
      h2a: "Systems Engineer, ",
      h2hl: "focused on front-end.",
      lead: "I build fast, responsive, well-crafted interfaces. I enjoy the technical detail as much as the design, and I'm always learning something new in this world. 🚀",
      expTitle: "Work experience",
      eduTitle: "Education",
      experience: [
        { dates: "NOV 2024 · PRESENT", role: "Front-End Developer", company: "Tatem · 🇲🇽 Mexico", accent: true, desc: "Admin portal and platform with Next.js, Astro and Tailwind. Google Maps reviews and self-invoicing for hotels." },
        { dates: "SEP 2024 · PRESENT", role: "Mobile Developer · React Native", company: "NCAS Tech · 🇨🇱 Chile", accent: true, desc: "SIPEC Puentes and SIRIAOF apps with offline-first architecture. Development, debugging and API integration." },
        { dates: "NOV 2023 · SEP 2024", role: "Front-End Developer", company: "Smart Hiring · 🇵🇷 Puerto Rico", accent: false, desc: "Sites and systems for the Puerto Rican market with Astro, Next.js, React and Sass. Animations and SEO optimization." },
        { dates: "SEP 2023 · OCT 2023", role: "Web Developer · Angular", company: "Vision Games Corporation · 🇵🇪 Peru", accent: false, desc: "Internal HR system with Angular, Angular Material and API consumption." },
        { dates: "APR 2023 · JUL 2023", role: "Jr. Frontend Web Developer", company: "VEVIG · 🇵🇪 Peru", accent: false, desc: "Landing pages and ecommerce with Astro, React and Sass (BEM methodology)." },
        { dates: "MAR 2022 · DEC 2022", role: "Intern · Systems Engineering", company: "Grupo Peruano de Capitales · 🇵🇪 Peru", accent: false, desc: "Front-end and automation of the client onboarding process with Firebase." },
      ],
      education: [
        { dates: "2017 · 2023 · GRADUATED 2026", role: "Computer Systems Engineering", company: "Universidad Privada del Norte · 🇵🇪 Peru", accent: true, desc: "Professional degree in Computer Systems Engineering." },
        { dates: "MAY 2023", role: "Innovation & Digital Transformation", company: "Universidad Andrés Bello · 🇨🇱 Chile", accent: false, desc: "Intensive course on digital innovation trends and technologies." },
        { dates: "2022 · 2023", role: "ReactJS · JavaScript · Cybersecurity", company: "CoderHouse · 🇦🇷 Argentina", accent: false, desc: "Web development and cybersecurity program." },
        { dates: "2022", role: "Design Thinking", company: "Instituto Europeo de Postgrado", accent: false, desc: "User-centered design methodology." },
        { dates: "CERTIFICATE", role: "English A2+", company: "Euroidiomas", accent: false, desc: "English proficiency certification." },
      ],
    }
  : {
      h2a: "Ingeniero de Sistemas, ",
      h2hl: "enfocado en front-end.",
      lead: "Me dedico a construir interfaces rápidas, responsivas y bien cuidadas. Disfruto el detalle técnico tanto como el diseño, y siempre estoy aprendiendo algo nuevo en este mundo. 🚀",
      expTitle: "Experiencia laboral",
      eduTitle: "Formación",
      experience: [
        { dates: "NOV 2024 · PRESENTE", role: "Desarrollador Front-End", company: "Tatem · 🇲🇽 México", accent: true, desc: "Portal y plataforma administrativa con Next.js, Astro y Tailwind. Reseñas con Google Maps y autofacturación para hoteles." },
        { dates: "SEPT 2024 · PRESENTE", role: "Desarrollador Mobile · React Native", company: "NCAS Tech · 🇨🇱 Chile", accent: true, desc: "Apps SIPEC Puentes y SIRIAOF con arquitectura offline-first. Desarrollo, debugging e integración de APIs." },
        { dates: "NOV 2023 · SEPT 2024", role: "Desarrollador Front-End", company: "Smart Hiring · 🇵🇷 Puerto Rico", accent: false, desc: "Webs y sistemas para el mercado puertorriqueño con Astro, Next.js, React y Sass. Animaciones y optimización SEO." },
        { dates: "SEPT 2023 · OCT 2023", role: "Desarrollador Web · Angular", company: "Vision Games Corporation · 🇵🇪 Perú", accent: false, desc: "Sistema interno de RR. HH. con Angular, Angular Material y consumo de APIs." },
        { dates: "ABR 2023 · JUL 2023", role: "Desarrollador Web Frontend Jr.", company: "VEVIG · 🇵🇪 Perú", accent: false, desc: "Landing pages y ecommerce con Astro, React y Sass (metodología BEM)." },
        { dates: "MAR 2022 · DIC 2022", role: "Practicante · Ing. de Sistemas", company: "Grupo Peruano de Capitales · 🇵🇪 Perú", accent: false, desc: "Front-end y automatización del proceso de inscripción de clientes con Firebase." },
      ],
      education: [
        { dates: "2017 · 2023 · TITULADO 2026", role: "Ing. de Sistemas Computacionales", company: "Universidad Privada del Norte · 🇵🇪 Perú", accent: true, desc: "Título profesional de Ingeniero de Sistemas Computacionales." },
        { dates: "MAY 2023", role: "Innovación y Transformación Digital", company: "Universidad Andrés Bello · 🇨🇱 Chile", accent: false, desc: "Curso intensivo sobre tendencias y tecnologías de innovación digital." },
        { dates: "2022 · 2023", role: "ReactJS · JavaScript · Ciberseguridad", company: "CoderHouse · 🇦🇷 Argentina", accent: false, desc: "Programa de desarrollo web y ciberseguridad." },
        { dates: "2022", role: "Design Thinking", company: "Instituto Europeo de Postgrado", accent: false, desc: "Metodología de diseño centrado en el usuario." },
        { dates: "CERTIFICADO", role: "Inglés A2+", company: "Euroidiomas", accent: false, desc: "Certificación de competencia en inglés." },
      ],
    };
---

<section id="trayectoria" class="trayectoria">
  <div class="trayectoria__head" data-reveal>
    <h2 class="h2">{t.h2a}<span class="hl">{t.h2hl}</span></h2>
    <p class="trayectoria__lead">{t.lead}</p>
  </div>

  <div class="trayectoria__cols">
    <div data-reveal>
      <h3 class="col-title"><span class="col-title__n">01</span> {t.expTitle}</h3>
      <div class="timeline">
        <div class="timeline__line" aria-hidden="true"></div>
        {
          t.experience.map((item, i) => (
            <div
              class:list={[
                "tl-item",
                { "tl-item--last": i === t.experience.length - 1 },
              ]}
            >
              <span
                class:list={["tl-dot", { "tl-dot--active": item.accent }]}
              />
              <div class="tl-date">{item.dates}</div>
              <div class="tl-role">{item.role}</div>
              <div
                class:list={["tl-company", { "tl-company--accent": item.accent }]}
              >
                {item.company}
              </div>
              <p class="tl-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div data-reveal>
      <h3 class="col-title"><span class="col-title__n">02</span> {t.eduTitle}</h3>
      <div class="timeline">
        <div class="timeline__line" aria-hidden="true"></div>
        {
          t.education.map((item, i) => (
            <div
              class:list={[
                "tl-item",
                { "tl-item--last": i === t.education.length - 1 },
              ]}
            >
              <span
                class:list={["tl-dot", { "tl-dot--active": item.accent }]}
              />
              <div class="tl-date">{item.dates}</div>
              <div class="tl-role">{item.role}</div>
              <div
                class:list={["tl-company", { "tl-company--accent": item.accent }]}
              >
                {item.company}
              </div>
              <p class="tl-desc">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .trayectoria {
    padding: 8px 0;
  }
  .trayectoria__head {
    max-width: 640px;
    margin-bottom: 44px;
  }
  .h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.025em;
    margin: 0 0 12px;
    color: var(--ink-strong);
  }
  .hl {
    color: var(--accent);
  }
  .trayectoria__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .trayectoria__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .col-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .col-title__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .timeline {
    position: relative;
  }
  .timeline__line {
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 10px;
    width: 2px;
    background: #ededed;
  }
  .tl-item {
    position: relative;
    padding-left: 34px;
    padding-bottom: 26px;
  }
  .tl-item--last {
    padding-bottom: 0;
  }
  .tl-dot {
    position: absolute;
    left: 0;
    top: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--line);
  }
  .tl-dot--active {
    background: var(--accent);
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px var(--accent);
  }
  .tl-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-3-text);
    margin-bottom: 4px;
  }
  .tl-role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
  }
  .tl-company {
    font-size: 13.5px;
    color: var(--muted);
    font-weight: 600;
    margin: 1px 0 5px;
  }
  .tl-company--accent {
    color: var(--accent);
  }
  .tl-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted-2);
    margin: 0;
  }

  @media (max-width: 760px) {
    .trayectoria__cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
