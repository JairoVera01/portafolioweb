---
import { Image } from "astro:assets";

const isEnglish = Astro.url.pathname.startsWith("/en");
const year = new Date().getFullYear();
const tagline = isEnglish
  ? "Designed and built with care."
  : "Diseñado y construido con cuidado.";
---

<footer class="site-footer">
  <div class="jv-container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__avatar">
        <Image
          src="/assets/images/port2.webp"
          alt="Jairo Vera"
          width={64}
          height={64}
          format="webp"
          quality={90}
          loading="lazy"
        />
      </span>
      <span class="site-footer__name">Jairo Vera</span>
    </div>

    <div class="site-footer__meta">© {year} · {tagline}</div>

    <div class="site-footer__links">
      <a
        href="https://www.linkedin.com/in/frank-jairo-vera/"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn">in</a
      >
      <a
        href="https://github.com/JairoVera01"
        target="_blank"
        rel="noopener"
        aria-label="GitHub">gh</a
      >
    </div>
  </div>
</footer>

<style>
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 56px;
    border-top: 1px dashed var(--line);
    margin-top: 8px;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .site-footer__avatar {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid #e7e7e9;
    display: block;
    flex-shrink: 0;
  }
  .site-footer__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: grayscale(0.2);
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }

  .site-footer__meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-3-text);
  }

  .site-footer__links {
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .site-footer__links a {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--muted);
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .site-footer__links a:hover {
    border-color: #18181b;
    color: #18181b;
  }

  @media (max-width: 560px) {
    .site-footer__inner {
      justify-content: center;
      text-align: center;
    }
    .site-footer__meta {
      width: 100%;
      order: 3;
    }
  }
</style>
