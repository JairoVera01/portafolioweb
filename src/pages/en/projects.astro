---
import { META, projectsSchema } from "../../i18n/seo";
import Base from "../../layouts/Base.astro";
import ProjectsList from "../../components/projects/ProjectsList.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const meta = META.projects.en;
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<Base lang="en" title={meta.title} description={meta.description} schema={projectsSchema("en", url, meta.title)}>
  <ProjectsList lang="en" />
  <SiteFooter lang="en" />
</Base>
