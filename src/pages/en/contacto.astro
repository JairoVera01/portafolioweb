---
import { META, contactSchema } from "../../i18n/seo";
import Base from "../../layouts/Base.astro";
import ContactPage from "../../components/contact/ContactPage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const meta = META.contact.en;
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<Base lang="en" title={meta.title} description={meta.description} schema={contactSchema("en", url, meta.title)}>
  <ContactPage lang="en" />
  <SiteFooter lang="en" />
</Base>
