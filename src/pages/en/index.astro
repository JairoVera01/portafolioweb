---
import Layout from "../../layouts/main.astro";
import Hero from "../../components/home/hero.astro";
import Marquee from "../../components/home/marquee.astro";
import Services from "../../components/home/services.astro";
import LiveGlance from "../../components/home/live-glance.astro";
import Process from "../../components/home/process.astro";
import SectionSeparator from "../../components/home/section-separator.astro";
import Coverflow from "../../components/home/coverflow-3d.astro";
import Trayectoria from "../../components/home/trayectoria.astro";
import ContactCta from "../../components/home/contact-cta.astro";
---

<Layout
  title="Jairo Vera - Front-End Developer | Web & Mobile"
  description="Front-end developer with 4+ years of experience building fast, well-crafted web and mobile apps with Astro, Next.js, React and React Native. Browse my projects and let's talk."
>
  <div class="jv-container">
    <Hero lang="en" />
    <Marquee />
    <Services lang="en" />
    <LiveGlance lang="en" />
    <Process lang="en" />
    <Coverflow lang="en" />
    <SectionSeparator text="ABOUT ME" margin="92px 0 40px" />
    <Trayectoria lang="en" />
    <ContactCta lang="en" />
  </div>
</Layout>
