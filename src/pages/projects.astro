---
import { META, projectsSchema } from "../i18n/seo";
import Base from "../layouts/Base.astro";
import ProjectsList from "../components/projects/ProjectsList.astro";
import SiteFooter from "../components/SiteFooter.astro";
const meta = META.projects.es;
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<Base lang="es" title={meta.title} description={meta.description} schema={projectsSchema("es", url, meta.title)}>
  <ProjectsList lang="es" />
  <SiteFooter lang="es" />
</Base>
