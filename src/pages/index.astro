---
import Layout from "../layouts/main.astro";
import Hero from "../components/home/hero.astro";
import Marquee from "../components/home/marquee.astro";
import Services from "../components/home/services.astro";
import Process from "../components/home/process.astro";
import SectionSeparator from "../components/home/section-separator.astro";
import ProjectsGrid from "../components/home/projects-grid.astro";
import Trayectoria from "../components/home/trayectoria.astro";
import ContactCta from "../components/home/contact-cta.astro";
---

<Layout
  title="Jairo Vera - Desarrollador Front-End | Web & Mobile"
  description="Desarrollador front-end con más de 4 años de experiencia construyendo sitios web y apps móviles rápidas y bien hechas con Astro, Next.js, React y React Native. Mira mis proyectos y hablemos."
>
  <div class="jv-container">
    <Hero lang="es" />
    <Marquee />
    <Services lang="es" />
    <Process lang="es" />
    <SectionSeparator text="MIS PROYECTOS" />
    <ProjectsGrid lang="es" />
    <SectionSeparator text="SOBRE MÍ" margin="92px 0 40px" />
    <Trayectoria lang="es" />
    <ContactCta lang="es" />
  </div>
</Layout>
